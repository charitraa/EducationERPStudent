<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds only: lets the app reach a local backend over plain HTTP
         (http://10.0.2.2:8000). Release builds keep Android's HTTPS-only default. -->
    <application android:usesCleartextTraffic="true" tools:ignore="GoogleAppIndexingWarning"/>
</manifest>
